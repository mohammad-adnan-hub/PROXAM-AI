# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/proxam_ai

# JWT
# SECRET_KEY must be generated uniquely per deployment (e.g. openssl rand -hex 32).
# Do not reuse the example value below in production.
SECRET_KEY=replace-with-unique-secret-key-minimum-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Cookie
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# CORS
FRONTEND_URL=https://your-frontend-domain.com

# Email (for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@proxamai.com
SMTP_FROM_NAME=Proxam AI

# Dev mode: if true, reset URLs are logged to console instead of emailed
DEV_MODE=false

# Docs
DOCS_ENABLED=false

# Admin seed (used by seed_admin.py)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Platform Administrator
