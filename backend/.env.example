# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/proxam_ai

# JWT
SECRET_KEY=proxam-ai-super-secret-jwt-key-minimum-32-chars-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Cookie
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CORS
FRONTEND_URL=http://localhost:5173

# Email (for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@proxamai.com
SMTP_FROM_NAME=Proxam AI

# Dev mode: if true, reset URLs are logged to console instead of emailed
DEV_MODE=true

# Admin seed (used by seed_admin.py)
ADMIN_EMAIL=admin@proxamai.com
ADMIN_PASSWORD=AdminSecurePassword123!
ADMIN_FULL_NAME=Platform Administrator
