def test_submit_identity_unauthenticated(client: TestClient, session: Session):
    resp = client.post("/api/student/attempts/1/identity-verification", files={"photo": ("p.jpg", io.BytesIO(MINIMAL_JPEG), "image/jpeg")})
    assert resp.status_code == 401


def test_get_identity_unauthenticated(client: TestClient, session: Session):
    resp = client.get("/api/student/attempts/1/identity-verification")
    assert resp.status_code == 401


def test_submit_identity_other_students_attempt_forbidden(client: TestClient, session: Session):
    teacher = create_user(session, "teacher@test.edu", UserRole.teacher)
    create_user(session, "s1@test.edu", UserRole.student)
    create_user(session, "s2@test.edu", UserRole.student)
    test = create_active_test(session, "Exam", "PXAM-ID008", teacher.id)
    login(client, "s1@test.edu")
    attempt_id = create_attempt_via_api(client, test.id)
    login(client, "s2@test.edu")
    resp = submit_identity(client, attempt_id)
    assert resp.status_code == 403


def test_get_identity_other_students_attempt_forbidden(client: TestClient, session: Session):
    teacher = create_user(session, "teacher@test.edu", UserRole.teacher)
    create_user(session, "s1@test.edu", UserRole.student)
    create_user(session, "s2@test.edu", UserRole.student)
    test = create_active_test(session, "Exam", "PXAM-ID009", teacher.id)
    login(client, "s1@test.edu")
    attempt_id = create_attempt_via_api(client, test.id)
    submit_identity(client, attempt_id)
    login(client, "s2@test.edu")
    resp = client.get(f"/api/student/attempts/{attempt_id}/identity-verification")
    assert resp.status_code == 403


# ---------------------------------------------------------------------------
# Lifecycle / duplicate / start gating
# ---------------------------------------------------------------------------

def test_submit_identity_invalid_attempt_status_finalized(client: TestClient, session: Session):
    teacher = create_user(session, "teacher@test.edu", UserRole.teacher)
    create_user(session, "student@test.edu", UserRole.student)
    test = create_active_test(session, "Exam", "PXAM-ID010", teacher.id)
    login(client, "student@test.edu")
    attempt_id = create_attempt_via_api(client, test.id)
    attempt = session.get(Attempt, attempt_id)
    attempt.status = AttemptStatus.submitted
    attempt.submitted_at = datetime.now(timezone.utc)
    session.add(attempt)
    session.commit()
    resp = submit_identity(client, attempt_id)
    assert resp.status_code == 409


def test_duplicate_identity_submission_rejected(client: TestClient, session: Session):
    teacher = create_user(session, "teacher@test.edu", UserRole.teacher)
    create_user(session, "student@test.edu", UserRole.student)
    test = create_active_test(session, "Exam", "PXAM-ID011", teacher.id)
    login(client, "student@test.edu")
    attempt_id = create_attempt_via_api(client, test.id)
    assert submit_identity(client, attempt_id).status_code == 201
    resp = submit_identity(client, attempt_id)
    assert resp.status_code == 409


def test_start_attempt_requires_identity_submission(client: TestClient, session: Session):
    teacher = create_user(session, "teacher@test.edu", UserRole.teacher)
    create_user(session, "student@test.edu", UserRole.student)
    test = create_active_test(session, "Exam", "PXAM-ID012", teacher.id)
    login(client, "student@test.edu")
    attempt_id = create_attempt_via_api(client, test.id)
    resp = client.post(f"/api/student/attempts/{attempt_id}/start")
    assert resp.status_code == 409
    assert "identity" in resp.json()["detail"].lower()


def test_start_attempt_allowed_after_pending_submission(client: TestClient, session: Session):
    teacher = create_user(session, "teacher@test.edu", UserRole.teacher)
    create_user(session, "student@test.edu", UserRole.student)
    test = create_active_test(session, "Exam", "PXAM-ID013", teacher.id)
    login(client, "student@test.edu")
    attempt_id = create_attempt_via_api(client, test.id)
    assert submit_identity(client, attempt_id).status_code == 201
    resp = client.post(f"/api/student/attempts/{attempt_id}/start")
    assert resp.status_code == 200
    assert resp.json()["status"] == "in_progress"


# ---------------------------------------------------------------------------
# Student cannot change verification/reviewer decisions; privacy protections
# ---------------------------------------------------------------------------

def test_student_cannot_change_verification_status_via_student_apis(client: TestClient, session: Session):
    teacher = create_user(session, "teacher@test.edu", UserRole.teacher)
    create_user(session, "student@test.edu", UserRole.student)
    test = create_active_test(session, "Exam", "PXAM-ID014", teacher.id)
    login(client, "student@test.edu")
    attempt_id = create_attempt_via_api(client, test.id)
    assert submit_identity(client, attempt_id).status_code == 201
    # no student endpoint exists to review/verify; submitting again is blocked
    assert submit_identity(client, attempt_id).status_code == 409
    record = session.exec(select(AttemptIdentityVerification).where(AttemptIdentityVerification.attempt_id == attempt_id)).first()
    assert record.status == IdentityVerificationStatus.pending
    assert record.reviewer_id is None
    assert record.reviewed_at is None


def test_identity_status_does_not_expose_internal_storage_or_paths(client: TestClient, session: Session):
    teacher = create_user(session, "teacher@test.edu", UserRole.teacher)
    create_user(session, "student@test.edu", UserRole.student)
    test = create_active_test(session, "Exam", "PXAM-ID015", teacher.id)
    login(client, "student@test.edu")
    attempt_id = create_attempt_via_api(client, test.id)
    submit_identity(client, attempt_id)
    resp = client.get(f"/api/student/attempts/{attempt_id}/identity-verification")
    body = resp.text.lower()
    assert "image_path" not in body
    assert "storage" not in body
    assert "backend\\" not in body and "backend/" not in body
    assert "attempt_" not in body  # relative path fragment must not leak

